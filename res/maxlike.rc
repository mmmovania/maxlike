#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "maxlike.manifest"

// Toolbar icons: 24x24 cells, magenta = transparent. Generated by tools/make_icons.py.
IDB_TOOLBAR_ICONS BITMAP "toolbar_icons.bmp"
// Status-area icons: 16x16 cells, same generator.
IDB_STATUS_ICONS  BITMAP "status_icons.bmp"
IDB_PANEL_TAB_ICONS BITMAP "panel_tab_icons.bmp"
IDB_PANEL_CATEGORY_ICONS BITMAP "panel_category_icons.bmp"
IDB_OBJECTS_ICONS BITMAP "objects_icons.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,5,0,0
PRODUCTVERSION  0,5,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "maxlike"
            VALUE "ProductName",     "maxlike"
            VALUE "FileVersion",     "0.5.0"
            VALUE "ProductVersion",  "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
